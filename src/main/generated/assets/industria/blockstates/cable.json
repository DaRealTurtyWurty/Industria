{
  "multipart": [
    {
      "apply": {
        "model": "industria:block/cable_center"
      }
    },
    {
      "apply": {
        "model": "industria:block/cable_continuous"
      },
      "when": {
        "north": "pipe"
      }
    },
    {
      "apply": {
        "model": "industria:block/cable_continuous",
        "y": 90
      },
      "when": {
        "east": "pipe"
      }
    },
    {
      "apply": {
        "model": "industria:block/cable_continuous",
        "y": 180
      },
      "when": {
        "south": "pipe"
      }
    },
    {
      "apply": {
        "model": "industria:block/cable_continuous",
        "y": 270
      },
      "when": {
        "west": "pipe"
      }
    },
    {
      "apply": {
        "model": "industria:block/cable_continuous_up"
      },
      "when": {
        "up": "pipe"
      }
    },
    {
      "apply": {
        "model": "industria:block/cable_continuous_down"
      },
      "when": {
        "down": "pipe"
      }
    },
    {
      "apply": {
        "model": "industria:block/cable_connection"
      },
      "when": {
        "north": "block"
      }
    },
    {
      "apply": {
        "model": "industria:block/cable_connection",
        "y": 90
      },
      "when": {
        "east": "block"
      }
    },
    {
      "apply": {
        "model": "industria:block/cable_connection",
        "y": 180
      },
      "when": {
        "south": "block"
      }
    },
    {
      "apply": {
        "model": "industria:block/cable_connection",
        "y": 270
      },
      "when": {
        "west": "block"
      }
    },
    {
      "apply": {
        "model": "industria:block/cable_connection_up"
      },
      "when": {
        "up": "block"
      }
    },
    {
      "apply": {
        "model": "industria:block/cable_connection_down"
      },
      "when": {
        "down": "block"
      }
    }
  ]
}